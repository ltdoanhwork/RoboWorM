metrics/rigis/.venv/
metrics/rigis/*.egg-info/

# Deployable labeling site (tracked despite webpage/* above). config.js IS
# committed here on purpose: SUPABASE_URL/PUBLISHABLE_KEY are meant to be
# public (Supabase's "publishable key" is safe client-side, gated by RLS),
# and ACCESS_PASSCODE is a soft anti-bot gate, not real security — it ships
# in the JS bundle on any deploy regardless of whether it's in git. Rotate
# the passcode any time by editing config.js and pushing.
!webpage/labeling/
!webpage/labeling/**
compare/*
# metric outputs / report tables: generated locally (created on first run)
/results/
assets/*
# ...but the paper-figure/table generators living under assets/ ARE source and
# must stay in git (assets/* above is meant to exclude heavy binary artifacts).
!assets/scripts/
!assets/scripts/**
# the negation above also re-included bytecode, so re-exclude it
assets/scripts/__pycache__/
# extracted video frames cached for the hero montage (regenerable, ~3 MB of JPEG)
metrics/reports/_hero_frames/
# transcoded analysis clips for the qualitative NR report (~5 MB of mp4, regenerable
# from the scored records via assets/scripts/make_nr_qualitative_report.py)
metrics/reports/nr_qualitative/clips/
archive/*
checkpoint_ablation/*
# LaTeX preview builds (tectonic output, regenerable)
assets/paper/_build/
assets/paper/_preview_*.tex
assets/paper/*.aux
assets/paper/*.log
assets/paper/*.out

# local chromium loader shim for headless screenshots (symlinks into miniforge pkgs)
.chromium-libs/
docs/paper/*.pdf

